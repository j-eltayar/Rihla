{
  "expo": {
    "name": "Rihla",
    "slug": "Rihla",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ios-splash.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "com.anonymous.Rihla",
    "splash": {
      "image": "./assets/ios-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#fffff0"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.Rihla",
      "icon": "./assets/ios-splash.png",
      "backgroundColor": "#fffff0",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app needs access to your location to help you find nearby places and add them to your lists."
      },
      "config": {
        "googleMapsApiKey": "AIzaSyDv3uen4tlhqrOs8CNXZthm-HWsyiaS1xo"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/ios-splash.png",
        "backgroundColor": "#fffff0"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.Rihla",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDv3uen4tlhqrOs8CNXZthm-HWsyiaS1xo"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Rihla to use your location to find nearby places."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d9193438-0e4d-4b63-ad9a-90dea465ba82"
      }
    }
  }
}
